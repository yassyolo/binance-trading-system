{
  "ConnectionStrings": {
    "TradingHistory": "Host=localhost;Port=55432;Database=trading;Username=trading;Password=change-me"
  },
  "TradingHistory": {
    "ConnectionStringName": "TradingHistory",
    "CommandTimeoutSeconds": 30
  },
  "Authentication": {
    "Issuer": "TradingDashboard",
    "Audience": "TradingDashboard",
    "SigningKey": "DEVELOPMENT-ONLY-CHANGE-THIS-SIGNING-KEY-32"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "AllowedHosts": "*",
  "ServiceHeartbeat": {
    "Enabled": true,
    "Environment": "Demo",
    "IntervalSeconds": 10,
    "StaleAfterSeconds": 30
  },
  "Swagger": {
    "Enabled": false
  },
  "ApiHardening": {
    "MaximumRequestBodyBytes": 1048576,
    "IdempotencyRetentionHours": 24
  }
}
